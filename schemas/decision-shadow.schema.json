{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiman.world/schemas/router/decision-shadow.schema.json",
  "title": "AIMAN System-One Shadow Decision Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "mode",
    "production_effect",
    "decisions",
    "router_shadow",
    "kev_compat",
    "route_hints",
    "provenance"
  ],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "production_effect": {"const": "none"},
    "decisions": {"type": "object"},
    "router_shadow": {"type": "object"},
    "kev_compat": {"type": "object"},
    "route_hints": {
      "type": "object",
      "required": ["required_capabilities"],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
