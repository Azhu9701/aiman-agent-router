{
  "id": "aiman.context-scout",
  "type": "agent",
  "name": "AIMAN Local Context Scout",
  "domains": ["*"],
  "capabilities": [
    "repository_context",
    "citation_lookup",
    "code_search"
  ],
  "protocols": ["native"],
  "provenance": "supported",
  "freshness": {
    "workspace_head": "committed_snapshot",
    "model": "local"
  },
  "write_policy": {
    "source_workspace": "forbidden",
    "arbitrary_shell": "forbidden",
    "production": "forbidden",
    "canonical_world_model": "forbidden"
  },
  "execution": {
    "target": "mac-worknode",
    "operation": "context.scout",
    "isolation": "committed_head_snapshot_no_remote",
    "tools": ["Read", "Glob", "Grep"]
  },
  "priority": 90,
  "enabled": true
}
